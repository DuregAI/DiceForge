#SettingsPanel {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    display: none; align-items: center; justify-content: center;
    background-color: rgba(24, 30, 18, 0.65);
}
#SettingsPanel.is-visible { display: flex; opacity: 1; }
#SettingsPanel .gh-settings-window { height: 860px; }
#SettingsPanel .gh-sound-block {
    flex-direction: row; align-items: center; flex-grow: 1;
    min-height: 264px; margin: 0 0 20px;
}
#SettingsPanel .gh-audio-controls { flex-grow: 1; flex-shrink: 1; min-width: 0; }
#SettingsPanel .gh-audio-controls.is-muted .gh-slider { opacity: 0.62; }
#SettingsPanel .gh-audio-label { font-size: 36px; margin: 0 0 2px 8px; color: rgb(74, 47, 24); }
#SettingsPanel .gh-speaker {
    width: 96px; height: 96px; min-width: 96px; margin: 0 24px 0 0; padding: 0;
    background-image: url("../07_Art/UI/GlimblehopMenu/audio-on.png");
    background-size: contain; background-color: transparent; border-width: 0;
}
#SettingsPanel .gh-speaker.is-muted { background-image: url("../07_Art/UI/GlimblehopMenu/audio-off.png"); }
#SettingsPanel .gh-slider { height: 76px; margin: 0 8px 14px; }
#SettingsPanel .gh-slider .unity-base-slider__tracker {
    height: 18px; border-radius: 9px; overflow: hidden;
    background-color: rgb(184, 143, 88); border-width: 2px; border-color: rgb(123, 87, 43);
}
#SettingsPanel .gh-volume-fill {
    position: absolute; left: 0; top: 0; bottom: 0; border-radius: 6px;
    background-color: rgb(117, 145, 53); border-top-width: 3px; border-top-color: rgb(177, 194, 100);
}
#SettingsPanel .gh-slider .unity-base-slider__dragger {
    width: 48px; height: 48px; border-radius: 22px; translate: 0 0;
    background-color: rgb(255, 225, 156); border-width: 4px;
    border-left-color: rgb(224, 177, 96); border-top-color: rgb(255, 243, 201);
    border-right-color: rgb(148, 100, 44); border-bottom-color: rgb(148, 100, 44);
}
#SettingsPanel .gh-slider .unity-base-slider__dragger-border { border-width: 0; }
#SettingsPanel .gh-slider:hover .unity-base-slider__dragger { background-color: rgb(255, 240, 193); }
#SettingsPanel .gh-slider:focus .unity-base-slider__tracker { border-color: rgb(77, 111, 39); }
#SettingsPanel .gh-settings-actions { flex-direction: row; justify-content: center; flex-shrink: 0; }
#SettingsPanel .gh-settings-actions .gh-button {
    flex-grow: 1; flex-basis: 0; min-width: 0; height: 76px; min-height: 76px;
    font-size: 25px; margin: 0 4px;
}
#SettingsPanel .gh-settings-build { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 16px 0 20px; flex-shrink: 0; }
#SettingsPanel .gh-settings-build Label { font-size: 28px; color: rgb(91, 62, 31); margin: 0 6px; }
#SettingsPanel #copyLogTooltip { position: absolute; bottom: 222px; left: 68px; right: 68px; }

#SettingsPanel .gh-slider .unity-base-slider__input { margin: 0; }
#SettingsPanel .gh-slider .unity-base-slider__tracker { margin-top: -9px; }
#SettingsPanel .gh-slider .unity-base-slider__dragger { margin-top: -24px; }
#SettingsPanel .gh-audio-label { margin-left: 0; }
#SettingsPanel .gh-slider { margin-left: 0; margin-right: 0; }
#SettingsPanel .gh-settings-actions .gh-button { margin: 0; }
#SettingsPanel .gh-settings-actions #btnCopyLog { margin-right: 16px; }
#SettingsPanel .gh-speaker { translate: 0 0; scale: 1 1; opacity: 1; }
