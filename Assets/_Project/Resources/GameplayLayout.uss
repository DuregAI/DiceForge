/* Gameplay overrides follow the shared material theme. Keep frame corners fixed
   while the content wraps; these selectors do not affect profile or shops. */
#woodlandRoot .hud-header,
#woodlandRoot #demoActionSurface,
#demoNarrativeRoot #storyDialogue,
#woodlandRoot .pause-window,
#demoNarrativeRoot .help-card {
    -unity-slice-left: 360; -unity-slice-right: 260;
    -unity-slice-top: 220; -unity-slice-bottom: 280;
}
#woodlandRoot .hud-header { -unity-slice-scale: .12px; }
#woodlandRoot #demoActionSurface,
#demoNarrativeRoot #storyDialogue { -unity-slice-scale: .15px; }
#woodlandRoot Button, #demoNarrativeRoot Button { -unity-slice-scale: .22px; }
#woodlandRoot .hud-header { padding: 18px 20px 12px; }
#woodlandRoot.demo-mode .top-bar { margin-right: 152px; padding: 0; }
#woodlandRoot .hud-actions { right: 16px; top: 16px; }
#demoNarrativeRoot #demoHelpButton { margin: 0; }
#woodlandRoot.demo-mode #demoActionSurface { padding: 26px 24px 22px; }
#woodlandRoot.demo-mode.has-dialogue #demoActionSurface { padding-right: 240px; }
#woodlandRoot.demo-mode.portrait #demoActionSurface { padding: 26px 22px 22px; }
#woodlandRoot.demo-mode .demo-step-group { flex-shrink: 1; min-width: 0; max-width: 100%; }
#woodlandRoot.demo-mode .moves { flex-wrap: wrap; flex-shrink: 1; }
#woodlandRoot.demo-mode .move-token {
    background-image: url("../07_Art/UI/GlimblehopMenu/button-secondary.png");
    background-size: 100% 100%;
    -unity-slice-left: 48; -unity-slice-right: 48;
    -unity-slice-top: 48; -unity-slice-bottom: 48;
    -unity-slice-scale: .22px;
    -unity-text-align: middle-center;
    margin-bottom: 8px; scale: 1 1;
}
#woodlandRoot.demo-mode .move-token.selected { -unity-background-image-tint-color: rgb(204,229,149); }
#woodlandRoot.demo-mode .demo-hero { white-space: normal; max-width: 100%; height: 52px; padding-top: 0; padding-bottom: 0; }
#woodlandRoot .pause-window {
    width: 420px; min-width: 0; max-width: 100%; max-height: 100%;
    padding: 44px 30px 30px; -unity-slice-scale: .22px;
}
#woodlandRoot .pause-title { background-image: none; min-height: 44px; padding: 0; }
#woodlandRoot .pause-window .unity-scroll-view__content-container { flex-shrink: 0; }
#woodlandRoot .pause-toggle { flex-shrink: 0; }
#woodlandRoot .pause-toggle .unity-toggle__label { white-space: normal; flex-shrink: 1; min-width: 0; }
#demoNarrativeRoot .help-card { padding: 44px 30px 30px; -unity-slice-scale: .22px; max-height: 94%; }
#demoNarrativeRoot .help-header, #demoNarrativeRoot .help-actions { flex-shrink: 0; }
#demoNarrativeRoot .help-actions Button { white-space: normal; min-height: 44px; max-width: 100%; }
#demoNarrativeRoot #helpTopics { min-height: 0; flex-shrink: 1; }
#demoNarrativeRoot #storyDialogue { padding: 28px 28px 24px; }
#demoNarrativeRoot .story-copy { min-width: 0; }
#demoNarrativeRoot .story-next { flex-shrink: 0; }
#demoNarrativeRoot .save-message { right: 12px; width: auto; max-width: 340px; }

#woodlandRoot.demo-mode.portrait .top-bar { min-height: 0; flex-shrink: 0; }
#woodlandRoot.demo-mode.portrait .score-panel { min-height: 32px; flex-shrink: 0; }

#woodlandRoot.demo-mode .demo-title { white-space: normal; min-width: 0; }
#woodlandRoot.demo-mode .demo-meta Label { white-space: normal; flex-shrink: 1; }
#woodlandRoot.demo-mode .demo-hero.selected {
 background-image: url("../07_Art/UI/GlimblehopMenu/button-secondary.png");
 -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 48; -unity-slice-bottom: 48;
 -unity-background-image-tint-color: rgb(197,221,146); color: rgb(44,59,22);
}
#woodlandRoot #pause, #woodlandRoot #settings,
#demoNarrativeRoot #demoHelpButton, #demoNarrativeRoot #helpClose,
#woodlandRoot #hintSkip, #demoNarrativeRoot #storyNext {
 background-image: none; background-color: rgb(104,65,32);
 border-width: 2px; border-color: rgb(224,180,100); border-radius: 28px;
 color: rgb(255,241,200); padding: 0; align-items: center; justify-content: center;
}
#woodlandRoot #pause:hover, #woodlandRoot #settings:hover,
#demoNarrativeRoot #demoHelpButton:hover, #demoNarrativeRoot #helpClose:hover,
#woodlandRoot #hintSkip:hover, #demoNarrativeRoot #storyNext:hover { background-color: rgb(137,87,40); }
#woodlandRoot #pause:focus, #woodlandRoot #settings:focus,
#demoNarrativeRoot #demoHelpButton:focus, #demoNarrativeRoot #helpClose:focus,
#woodlandRoot #hintSkip:focus, #demoNarrativeRoot #storyNext:focus { border-color: rgb(255,244,213); }
#woodlandRoot #pause:active, #woodlandRoot #settings:active,
#demoNarrativeRoot #demoHelpButton:active, #demoNarrativeRoot #helpClose:active,
#woodlandRoot #hintSkip:active, #demoNarrativeRoot #storyNext:active { scale: .94 .94; }
#demoNarrativeRoot #storyNext.continue { padding: 8px 20px; }

/* Put the complete friend roster on its own row on narrow screens. */
#woodlandRoot.demo-mode.narrow.multiple-heroes .action-row { flex-direction: column; align-items: stretch; }
#woodlandRoot.demo-mode.narrow.multiple-heroes .demo-step-group { width: 100%; margin-right: 0; }
#woodlandRoot.demo-mode.narrow.multiple-heroes .demo-hero-group { width: 100%; flex-basis: auto; flex-grow: 0; }
#woodlandRoot.demo-mode.narrow.multiple-heroes .demo-hero { flex-grow: 1; flex-shrink: 1; min-width: 0; padding-left: 8px; padding-right: 8px; }

#woodlandRoot.demo-mode .move-token:disabled,
#woodlandRoot.demo-mode .demo-hero:disabled { opacity: 1; }
#demoNarrativeRoot #demoHelpButton:disabled { opacity: .85; }
