    helpTopic: 
    speakerLabelRu: "\u0421\u043E\u0432\u0435\u0442 \u041B\u0443\u043C\u044B"
    ru: "\u041D\u0430\u0447\u043D\u0438 \u0443 \u043A\u0430\u043B\u0438\u0442\u043A\u0438. \u041E\u0434\u0438\u043D \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0448\u0430\u0433 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u0442\u0435\u0431\u044F \u043A \u0440\u0443\u0447\u044C\u044E."
