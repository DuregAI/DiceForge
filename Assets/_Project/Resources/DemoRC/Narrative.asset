    en: Choose 1, then Tish. Repeat until he's beyond the last tile.
    priority: 85
  - id: L02_I01
    levelId: L2
    speakerId: tish
    kind: level_intro
    domainEvent: level_entered
    helpTopic: 
    speakerLabelRu: 
    speakerLabelEn: 
