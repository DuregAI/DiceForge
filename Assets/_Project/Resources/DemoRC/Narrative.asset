    priority: 85
  - id: L01_T08
    levelId: L1
    speakerId: luma
    kind: tutorial
    domainEvent: legal_move_applied
    helpTopic: 
    speakerLabelRu: "\u0421\u043E\u0432\u0435\u0442 \u041B\u0443\u043C\u044B"
    ru: "\u0422\u044B \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C \u044D\u0442\u043E\u0442 \u0448\u0430\u0433. \u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0430\u043C; \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0432 \u0441\u043F\u0440\u0430\u0432\u043A\u0435."
    en: You know this move. Try on your own; Help is available.
    priority: 20
  - id: L01_T09
    levelId: L1
    speakerId: luma
    kind: tutorial
    domainEvent: help_requested
    helpTopic: goal
    speakerLabelRu: "\u0421\u043E\u0432\u0435\u0442 \u041B\u0443\u043C\u044B"
    ru: "\u041D\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u2014 \u043F\u0440\u043E\u0439\u0442\u0438 \u0432\u0441\u044E \u0442\u0440\u043E\u043F\u0443 \u0438 \u0432\u044B\u0439\u0442\u0438 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E \u043F\u043B\u0438\u0442\u0443."
