    en: Tish is through. This trail needed one hero to reach the exit.
    priority: 20
  - id: L01_T12
    levelId: L1
    speakerId: luma
    kind: tutorial
    domainEvent: help_requested
    helpTopic: summary
    speakerLabelRu: "\u0421\u043E\u0432\u0435\u0442 \u041B\u0443\u043C\u044B"
