  - id: G_A01
    levelId: GLOBAL
    speakerId: luma
    kind: accessibility_or_recovery
    domainEvent: tutorial_skip_requested
    helpTopic: 
    speakerLabelRu: 
    ru: "\u0425\u043E\u0440\u043E\u0448\u043E, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0441\u0432\u043E\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C. \u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u0441\u043D\u043E\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0432 \u0441\u043F\u0440\u0430\u0432\u043A\u0435."
