    helpTopic: 
    speakerLabelRu: 
    speakerLabelEn: 
    ru: "\u041E\u0434\u0438\u043D \u0434\u0440\u0443\u0433 \u0434\u043E\u0448\u0451\u043B, \u0432\u0442\u043E\u0440\u043E\u0439 \u0435\u0449\u0451 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435. \u0421\u0447\u0451\u0442\u0447\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0436\u0435 \u0443 \u0432\u044B\u0445\u043E\u0434\u0430."
