  scenes:
  - id: S00
    title: "\u0414\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0448\u0430\u0433\u0430"
    art: {fileID: 2800000, guid: 379fc49de77be1444b53f4e22ff1a6a5, type: 3}
    frames:
    - id: S00.1
      title: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
      lines:
      - id: S00.1a
        speakerId: tish
        ru: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0440\u043E\u0432\u043D\u043E"
      - id: S00.1b
        speakerId: luma
        ru: "\u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E"
    - id: S00.2
      title: "\u041B\u0438\u043D\u0437\u0430 \u0432 \u043F\u043E\u043B\u0451\u0442\u0435"
      lines:
      - id: S00.2a
        speakerId: kloch
        ru: "\u041E\u0434\u043E\u043B\u0436\u0443 \u0434\u043E \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430!"
      - id: S00.2b
        speakerId: tish
        ru: "\u041D\u043E \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u0437\u0434\u0435\u0441\u044C\u2026"
    - id: S00.3
      title: "\u0414\u0432\u0430 \u0440\u0435\u0448\u0435\u043D\u0438\u044F"
      lines:
      - id: S00.3a
        speakerId: tish
        ru: "\u0412\u0435\u0440\u043D\u0443 \u043B\u0438\u043D\u0437\u0443. \u042F \u0431\u044B\u0441\u0442\u0440\u043E"
      - id: S00.3b
        speakerId: luma
        ru: "\u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u043C\u043E\u0441\u0442. \u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0442\u0430\u043C"
  - id: S01
    title: "\u0421\u043B\u0435\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435"
    art: {fileID: 2800000, guid: 65def979d3f11974980710d61e8afca9, type: 3}
    frames:
    - id: S01.1
      title: "\u041D\u0430 \u043A\u0440\u0430\u044E \u0434\u0432\u043E\u0440\u0430"
      lines:
      - id: S01.1a
        speakerId: pip
        ru: "\u0414\u044F\u0434\u044F! \u041C\u044B \u043D\u0430\u0448\u043B\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435!"
    - id: S01.2
      title: "\u0414\u0432\u0435 \u043D\u0430\u0445\u043E\u0434\u043A\u0438"
      lines:
      - id: S01.2a
        speakerId: pip
        ru: "\u042F \u043D\u0430\u0448\u0451\u043B \u0441\u0435\u0432\u0435\u0440"
      - id: S01.2b
        speakerId: fika
        ru: "\u0410 \u044F \u2014 \u043F\u0435\u0440\u043E \u0443 \u0440\u0443\u0447\u044C\u044F"
    - id: S01.3
      title: "\u0412 \u043F\u0443\u0442\u044C, \u0434\u043E\u043C\u0430 \u0442\u043E\u0436\u0435 \u0435\u0441\u0442\u044C \u0434\u0435\u043B\u043E"
      lines:
      - id: S01.3a
        speakerId: tish
        ru: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u0413\u0438\u0440\u043B\u044F\u043D\u0434\u0443 \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0432\u0430\u043C"
  - id: S02
    title: "\u0420\u044F\u0434\u043E\u043C \u043F\u043E \u0441\u0432\u043E\u0435\u0439 \u0432\u043E\u043B\u0435"
    art: {fileID: 2800000, guid: 7d86f39fa992efe42b636a38d10a6a95, type: 3}
    frames:
    - id: S02.1
      title: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u0435\u0440\u0435\u0433"
      lines:
      - id: S02.1a
        speakerId: tish
        ru: "\u0410 \u0442\u044B \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044C"
    - id: S02.2
      title: "\u0415\u0451 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430"
      lines:
      - id: S02.2a
        speakerId: luma
        ru: "\u041C\u043E\u0441\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430. \u0414\u043E \u041A\u043E\u0440\u043D\u044F \u0434\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435"
    - id: S02.3
      title: "\u041C\u0435\u0441\u0442\u043E \u0440\u044F\u0434\u043E\u043C"
      lines:
      - id: S02.3a
        speakerId: tish
        ru: "\u042F \u0445\u043E\u0442\u0435\u043B \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0441\u0430\u043C\u2026"
      - id: S02.3b
        speakerId: luma
        ru: "\u041C\u043E\u0436\u0435\u0448\u044C \u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u043C\u043D\u043E\u0439"
  - id: S03
    title: "\u0422\u043E, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0432\u0441\u0435\u043C"
    art: {fileID: 2800000, guid: e1d3604e46e1ebc49a37b53215dea3c8, type: 3}
    frames:
    - id: S03.1
      title: "\u0423 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439"
      lines:
      - id: S03.1a
        speakerId: koren
        ru: "\u0411\u0435\u0437 \u044D\u0442\u043E\u0439 \u043B\u0438\u043D\u0437\u044B \u0438 \u0442\u0440\u043E\u043F\u0430 \u0442\u0443\u0441\u043A\u043B\u0435\u0435"
    - id: S03.2
      title: "\u0414\u0432\u0430 \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u0441\u0432\u0435\u0442\u0430"
      lines:
      - id: S03.2a
        speakerId: koren
        ru: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0432\u0435\u0442 \u043D\u0443\u0436\u0435\u043D \u0432\u0441\u0435\u043C. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F"
      - id: S03.2b
        speakerId: bum
        ru: "\u042F \u043F\u043E\u043D\u0435\u0441\u0443. \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    - id: S03.3
      title: "\u0422\u0440\u043E\u0435 \u0432 \u0434\u0432\u0435\u0440\u044F\u0445"
      lines:
      - id: S03.3a
        speakerId: tish
        ru: "\u0414\u0432\u0435\u0440\u044C \u0434\u0435\u0440\u0436\u0443. \u0418\u0434\u0451\u043C \u0432\u0442\u0440\u043E\u0451\u043C"
      - id: S03.3b
        speakerId: bum
        ru: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u0451 \u043F\u043E\u043D\u044F\u0442\u043D\u043E"
  - id: S04
    title: "\u0427\u0443\u0436\u043E\u0439 \u0442\u0435\u043C\u043F"
    art: {fileID: 2800000, guid: d7c53fb2c1d303c4ea479d65bb277af2, type: 3}
    frames:
    - id: S04.1
      title: "\u0416\u0443\u043A \u0437\u0430\u043D\u044F\u0442 \u0441\u0432\u043E\u0438\u043C \u0434\u0435\u043B\u043E\u043C"
      lines:
      - id: S04.1a
        speakerId: bum
        ru: "\u041E\u043D \u0442\u043E\u0436\u0435 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0441\u043F\u0435\u0448\u0438\u0442\u044C"
    - id: S04.2
      title: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u0428\u0430\u043B\u0430"
      lines:
      - id: S04.2a
        speakerId: shal
        ru: "\u0414\u043E \u043F\u043E\u043B\u044F\u043D\u044B \u0431\u043B\u0438\u0437\u043A\u043E. \u0422\u043E\u043B\u044C\u043A\u043E \u0420\u044B\u0436 \u043E\u043F\u044F\u0442\u044C \u043E\u0431\u044A\u044F\u0432\u0438\u043B \u0433\u043E\u043D\u043A\u0443"
    - id: S04.3
      title: "\u0412\u044B\u0437\u043E\u0432 \u0443 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F"
      lines:
      - id: S04.3a
        speakerId: ryzh
        ru: "\u041A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439 \u043A \u043F\u043E\u043B\u044F\u043D\u0435?"
      - id: S04.3b
        speakerId: luma
        ru: "\u041D\u0430\u043C \u0432\u0430\u0436\u043D\u043E \u0434\u043E\u0439\u0442\u0438 \u0432\u0441\u0435\u043C"
  - id: S05
    title: "\u041A\u043E\u043C\u0443 \u043D\u0443\u0436\u0435\u043D \u0441\u0432\u0435\u0442"
    art: {fileID: 2800000, guid: f9c679d12a4810b47a12973ae2dadc5e, type: 3}
    frames:
    - id: S05.1
      title: "\u041E\u0431\u0449\u0438\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442"
      lines:
      - id: S05.1a
        speakerId: ryzh
        ru: "\u0412\u044B \u043F\u0440\u0438\u0448\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435. \u0422\u043E\u0436\u0435 \u0443\u043C\u0435\u0435\u0442\u0435!"
      - id: S05.1b
        speakerId: tish
        ru: "\u041C\u044B \u0442\u0430\u043A \u0438 \u0445\u043E\u0442\u0435\u043B\u0438"
    - id: S05.2
      title: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0447\u0430\u0439 \u0431\u0435\u0437 \u0433\u043E\u0441\u0442\u044F"
      lines:
      - id: S05.2a
        speakerId: luma
        ru: "\u0417\u0430\u0447\u0435\u043C \u0442\u0435\u0431\u0435 \u043D\u0430\u0448\u0430 \u043B\u0438\u043D\u0437\u0430?"
      - id: S05.2b
        speakerId: kloch
        ru: "\u0427\u0442\u043E\u0431\u044B \u0433\u043E\u0441\u0442\u0438 \u043D\u0430\u0448\u043B\u0438 \u043C\u043E\u0439 \u0441\u0442\u043E\u043B\u2026"
    - id: S05.3
      title: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u0442\u044C"
      lines:
      - id: S05.3a
        speakerId: tish
        ru: "\u042D\u0442\u043E\u0442 \u2014 \u0442\u0435\u0431\u0435. \u0410 \u043C\u0435\u0441\u0442\u043E \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C \u2014 \u0441 \u043D\u0430\u043C\u0438"
      - id: S05.3b
        speakerId: kloch
        ru: "\u042F \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B. \u041F\u0440\u043E\u0441\u0442\u0438. \u0412\u0435\u0440\u043D\u0443 \u043E\u0431\u0449\u0438\u0439 \u0441\u0432\u0435\u0442"
  - id: S06
    title: "\u041E\u0431\u0449\u0438\u0439 \u0441\u0442\u043E\u043B"
    art: {fileID: 2800000, guid: 88d2820b07a37b54abd411393de1d203, type: 3}
    frames:
    - id: S06.1
      title: "\u0421\u0432\u0435\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
      lines:
      - id: S06.1a
        speakerId: tish
        ru: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041E\u0434\u043D\u043E\u043C\u0443 \u0431\u044B\u043B\u043E \u0431\u044B \u0442\u0440\u0443\u0434\u043D\u0435\u0435"
      - id: S06.1b
        speakerId: koren
        ru: "\u0412\u043E\u0442 \u0438 \u0441\u0432\u0435\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
    - id: S06.2
      title: "\u0421\u0432\u0430\u0434\u044C\u0431\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u0434\u0432\u043E\u0435"
      lines:
      - id: S06.2a
        speakerId: luma
        ru: "\u0411\u0443\u0434\u0435\u043C \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443 \u0432\u043C\u0435\u0441\u0442\u0435?"
      - id: S06.2b
        speakerId: tish
        ru: "\u0418 \u043C\u0435\u0441\u0442\u043E \u0434\u0440\u0443\u0433 \u0434\u043B\u044F \u0434\u0440\u0443\u0433\u0430 \u2014 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C"
    - id: S06.3
      title: "\u0413\u043E\u0441\u0442\u044C \u043B\u044E\u0431\u043E\u0433\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430"
      lines:
      - id: S06.3a
        speakerId: kloch
        ru: "\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437 \u0441\u043F\u0440\u043E\u0448\u0443. \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0431\u043B\u0435\u0441\u0442\u0438\u0442"
      - id: S06.3b
        speakerId: bum
        ru: "\u041F\u043B\u0430\u0442\u043E\u043A \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439. \u0420\u0430\u0434\u043E\u0441\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0430\u044F"
