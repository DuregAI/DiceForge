    helpTopic: 
    speakerLabelRu: "\u0421\u043E\u0432\u0435\u0442 \u041B\u0443\u043C\u044B"
    ru: "\u0422\u0438\u0448 \u0434\u043E\u0448\u0451\u043B. \u041D\u0430 \u044D\u0442\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0433\u0435\u0440\u043E\u044F."
