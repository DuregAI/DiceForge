    domainEvent: help_requested
    helpTopic: 
    speakerLabelRu: 
    ru: "\u0427\u0442\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C: \u0448\u0430\u0433\u0438, \u0432\u044B\u0431\u043E\u0440 \u0434\u0440\u0443\u0433\u0430, \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E \u043F\u043E\u0441\u0430\u0434\u043A\u0443 \u0438\u043B\u0438 \u0432\u044B\u0445\u043E\u0434?"
