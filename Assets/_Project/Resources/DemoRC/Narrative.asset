    helpTopic: hero_order
    speakerLabelRu: 
    speakerLabelEn: 
    ru: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0439\u0442\u0438 \u043B\u044E\u0431\u043E\u0439 \u0438\u0437 \u043D\u0430\u0441, \u0435\u0441\u043B\u0438 \u0435\u0433\u043E \u0445\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D. \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u043D\u0435\u0442."
