    priority: 75
  - id: G_E09
    levelId: GLOBAL
    speakerId: luma
    kind: global_feedback
    domainEvent: input_rejected
    helpTopic: 
    speakerLabelRu: 
    ru: "\u042D\u0442\u043E\u0442 \u0448\u0430\u0433 \u0443\u0436\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D. \u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u0448\u0430\u0433\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B."
