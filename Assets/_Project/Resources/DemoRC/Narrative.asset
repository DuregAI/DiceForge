    en: Our goal is to cross the trail and move beyond the last tile.
    priority: 85
  - id: L01_T10
    levelId: L1
    speakerId: luma
    kind: tutorial
    domainEvent: step_offer_ready
    helpTopic: 
    speakerLabelRu: "\u0421\u043E\u0432\u0435\u0442 \u041B\u0443\u043C\u044B"
