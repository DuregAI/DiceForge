    priority: 80
  - id: G_A05
    levelId: GLOBAL
    speakerId: luma
    kind: accessibility_or_recovery
    domainEvent: help_requested
    helpTopic: text
    speakerLabelRu: 
    ru: "\u0420\u0435\u043F\u043B\u0438\u043A\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F, \u043F\u043E\u043A\u0430 \u0442\u044B \u0435\u0451 \u043D\u0435 \u0437\u0430\u043A\u0440\u043E\u0435\u0448\u044C. \u0420\u0430\u0437\u043C\u0435\u0440 \u0442\u0435\u043A\u0441\u0442\u0430 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C."
