#woodlandRoot {
    flex-grow: 1;
    padding: 14px 22px 16px;
    color: rgb(255, 240, 202);
}
.hud-header { flex-shrink: 0; }
.top-bar { flex-direction: row; align-items: center; justify-content: center; }
.score-panel {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 60px;
    padding: 7px 17px 10px;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/counter-panel.png");
    background-size: 100% 100%;
}
.team-icon { width: 29px; height: 33px; margin-right: 8px; flex-shrink: 0; }
.score-copy { align-items: center; justify-content: center; }
.score {
    font-size: 23px;
    -unity-font-definition: url("project://database/Assets/_Project/07_Art/Fonts/AlfaSlabOne-Regular.ttf");
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.role { font-size: 11px; -unity-font-style: bold; margin: 0; padding: 0; -unity-text-align: middle-center; }
.warm { color: rgb(248, 165, 117); }
.cool { color: rgb(151, 221, 214); }
.turn-plaque {
    width: 268px;
    height: 72px;
    margin: 0 7px;
    justify-content: center;
    padding: 8px 40px 12px;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMap/title-plaque.png");
    background-size: 100% 100%;
}
.turn {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/_Project/07_Art/Fonts/AlfaSlabOne-Regular.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 1px rgba(41, 23, 13, .9);
}
.hud-actions { position: absolute; right: 0; top: 8px; flex-direction: row; align-items: center; }
Button {
    background-color: rgb(111, 67, 31);
    color: rgb(255, 237, 191);
    border-color: rgb(178, 131, 64);
    border-width: 2px;
    border-radius: 10px;
    min-height: 44px;
    padding: 5px 14px;
    font-size: 17px;
}
Button:hover { background-color: rgb(144, 93, 43); }
Button:disabled { opacity: .58; }
.pause {
    width: 48px;
    height: 48px;
    margin: 0 7px 0 0;
    padding: 0;
    border-radius: 28px;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/07_Art/UI/WoodlandBattle/pause-button.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.pause:hover { scale: 1.04 1.04; background-color: transparent; -unity-background-image-tint-color: rgb(255, 239, 208); }
.pause:active { scale: 0.96 0.96; background-color: transparent; -unity-background-image-tint-color: rgb(226, 209, 178); }
.pause:focus { border-width: 2px; border-color: rgb(255, 235, 185); }
.settings {
    width: 48px;
    height: 48px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/settings.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.settings:hover { scale: 1.04 1.04; background-color: transparent; }
.board-space { flex-grow: 1; }
.bottom-bar {
    flex-shrink: 0;
    align-self: center;
    align-items: center;
    min-width: 264px;
    max-width: 560px;
    padding: 10px 25px 18px;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/counter-panel.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 55;
    -unity-slice-bottom: 55;
    -unity-slice-scale: 0.65px;
}
.moves { flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 100%; }
.move-token {
    flex-shrink: 0;
    width: 104px;
    height: 104px;
    min-height: 0;
    margin: 7px 8px 4px;
    padding: 0 0 8px;
    border-radius: 60px;
    border-width: 3px;
    border-color: transparent;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/07_Art/UI/WoodlandBattle/move-token.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    color: rgb(63, 34, 18);
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/_Project/07_Art/Fonts/AlfaSlabOne-Regular.ttf");
    -unity-text-align: lower-center;
}
.move-token:hover { background-color: transparent; -unity-background-image-tint-color: rgb(255, 246, 215); }
.move-token.selected { border-color: rgb(255, 246, 205); scale: 1.045 1.045; }
.move-token:disabled { opacity: .6; background-color: transparent; }
.move-token:focus { border-color: rgb(255, 246, 205); }
.token-marker { display: none; position: absolute; width: 23px; height: 27px; top: -12px; right: 2px; }
.move-token.selected .token-marker { display: flex; }
.bottom-line { flex-direction: row; align-items: center; justify-content: center; max-width: 100%; padding: 3px 9px 0; }
#hint {
    flex-shrink: 1;
    font-size: 16px;
    margin: 0;
    padding: 0 4px;
    white-space: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 1px rgb(43, 23, 11);
}
#reroll {
    flex-shrink: 0;
    margin: 0 0 0 10px;
    min-height: 38px;
    padding: 5px 17px 8px;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/button-secondary.png");
    background-size: 100% 100%;
    color: rgb(65, 38, 20);
    -unity-font-style: bold;
    font-size: 14px;
}
#reroll:hover { -unity-background-image-tint-color: rgb(255, 239, 198); }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(13, 31, 25, .48); align-items: center; justify-content: center; }
.pause-overlay { padding: 16px; }
.pause-window {
    width: 360px;
    max-width: 100%;
    padding: 20px 26px 24px;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/counter-panel.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 55;
    -unity-slice-bottom: 55;
    -unity-slice-scale: 0.65px;
}
.pause-title {
    min-height: 80px;
    margin: 0 0 10px;
    padding: 16px 33px 21px;
    font-size: 27px;
    color: rgb(255, 241, 207);
    -unity-font-definition: url("project://database/Assets/_Project/07_Art/Fonts/AlfaSlabOne-Regular.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 2px 1px rgba(41, 23, 13, .9);
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMap/title-plaque.png");
    background-size: 100% 100%;
}
.pause-window .pause-action {
    min-height: 44px;
    margin: 6px 0 0;
    padding: 8px 22px 11px;
    border-width: 0;
    color: rgb(255, 237, 198);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/counter-panel.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 55;
    -unity-slice-bottom: 55;
    -unity-slice-scale: 0.32px;
}
.pause-window .pause-primary {
    min-height: 50px;
    color: rgb(66, 38, 20);
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/button-secondary.png");
    -unity-slice-left: 65;
    -unity-slice-right: 65;
    -unity-slice-top: 35;
    -unity-slice-bottom: 35;
    -unity-slice-scale: 0.5px;
}
.pause-window .pause-action:hover { background-color: transparent; -unity-background-image-tint-color: rgb(255, 239, 210); }
.pause-window .pause-action:active { background-color: transparent; -unity-background-image-tint-color: rgb(224, 206, 174); }
.pause-window .pause-action:focus { border-width: 2px; border-color: rgb(255, 230, 176); border-radius: 22px; }
.pause-window .pause-surrender { margin-top: 14px; color: rgb(235, 176, 146); -unity-background-image-tint-color: rgb(198, 164, 143); }
.pause-options { margin-top: 12px; padding: 3px 5px; }
.pause-toggle { min-height: 40px; margin: 0; color: rgb(243, 226, 193); font-size: 16px; -unity-font-style: bold; }
.pause-toggle .unity-toggle__input { flex-grow: 1; align-items: center; justify-content: space-between; min-height: 40px; }
.pause-toggle .unity-toggle__text { flex-grow: 1; margin: 0; white-space: normal; }
.pause-toggle .unity-toggle__checkmark { display: none; }
.pause-toggle-check {
    width: 26px;
    min-width: 26px;
    height: 26px;
    padding: 0;
    margin: 0 0 0 12px;
    border-width: 1px;
    border-color: rgb(184, 144, 82);
    border-radius: 6px;
    background-color: rgb(53, 42, 27);
    color: transparent;
}
.pause-toggle:checked .pause-toggle-check { color: rgb(255, 241, 202); background-color: rgb(125, 107, 57); }
.pause-toggle:hover .pause-toggle-check { border-color: rgb(255, 225, 169); }
.pause-confirm-message { margin: 8px 10px 16px; font-size: 18px; color: rgb(243, 226, 193); white-space: normal; -unity-text-align: middle-center; }
.pause-overlay .df-window-close-icon { display: none; }
.narrow .pause-window { width: 320px; padding: 18px 22px 22px; }
.narrow .pause-title { font-size: 25px; }
.hidden { display: none; }
.demo-title { white-space: normal; }
.demo-step-rule { font-size: 16px; margin: 0 0 4px; -unity-text-align: middle-center; }
.demo-hazard-hint { font-size: 14px; margin: 3px 0; white-space: normal; -unity-text-align: middle-center; }
.demo-dialogue-dock { display: none; flex-shrink: 0; }
.demo-heroes { flex-direction: row; justify-content: center; flex-wrap: wrap; }
.demo-hero { min-height: 44px; margin: 4px; padding: 6px 16px; }
.demo-hero-luma { background-color: rgb(42, 92, 85); border-color: rgb(113, 199, 189); }
.demo-hero-bum { background-color: rgb(114, 79, 35); border-color: rgb(220, 173, 77); }
.demo-hero.selected { border-color: rgb(255, 224, 135); border-width: 3px; }
.demo-selected-hero { font-size: 14px; margin: 2px 0; -unity-text-align: middle-center; white-space: normal; }
.compact .top-bar { margin-right: 108px; }
.compact .score-panel { width: 117px; height: 56px; padding-left: 12px; padding-right: 12px; }
.compact .team-icon { width: 24px; height: 29px; margin-right: 5px; }
.compact .score { font-size: 21px; }
.compact .turn-plaque { width: 220px; height: 64px; padding-left: 31px; padding-right: 31px; margin-left: 4px; margin-right: 4px; }
.compact .turn { font-size: 18px; }
.narrow .top-bar { margin-right: 0; padding-top: 62px; }
.narrow .turn-plaque { position: absolute; top: 0; left: 0; right: 108px; width: auto; height: 59px; margin: 0; padding-left: 27px; padding-right: 27px; }
.narrow .turn { font-size: 17px; }
.narrow .score-panel { width: auto; flex-grow: 1; max-width: 156px; margin-left: 4px; margin-right: 4px; }
.narrow .hud-actions { top: 5px; }
.narrow .bottom-bar { min-width: 0; max-width: 100%; padding: 8px 14px 17px; }
.narrow .move-token { width: 78px; height: 78px; font-size: 21px; padding-bottom: 4px; margin: 5px; }
.narrow .token-marker { width: 20px; height: 23px; top: -10px; }
.narrow .bottom-line { flex-direction: column; }
.narrow #hint { font-size: 15px; }
.narrow #reroll { margin: 7px 0 0; }


.demo-control-caption, .demo-hero-group { display: none; }
.demo-mode .top-bar {
    justify-content: flex-start;
    align-self: flex-start;
    max-width: 100%;
    margin: 0 164px 0 0;
    padding: 9px 16px;
    min-height: 48px;
    background-color: rgba(24, 49, 40, .86);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(248, 243, 230, .12);
}
.demo-mode .demo-title { flex-shrink: 1; max-width: 58%; white-space: normal; margin: 0 20px 0 0; padding: 0; font-size: 22px; color: var(--demo-surface); -unity-font-style: bold; -unity-text-align: middle-left; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.demo-mode .score-panel { width: auto; height: 32px; margin: 0 16px 0 0; padding: 0 0 0 16px; background-image: none; border-left-width: 1px; border-left-color: rgba(248, 243, 230, .18); }
.demo-mode .team-icon { width: 20px; height: 24px; margin-right: 8px; }
.demo-mode .score { font-size: 20px; color: var(--demo-surface); }
.demo-mode .role { display: none; }
.demo-mode .turn-plaque { position: relative; left: auto; right: auto; top: auto; width: auto; height: 32px; margin: 0; padding: 0; background-image: none; border-left-width: 0; }
.demo-mode .turn { font-size: 13px; color: rgb(200, 216, 200); -unity-font-style: normal; -unity-text-align: middle-left; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.demo-mode .hud-actions { top: 0; }
.demo-mode .pause, .demo-mode .settings { width: 44px; height: 44px; min-height: 44px; background-image: none; background-color: var(--demo-surface); border-width: 2px; border-color: transparent; border-radius: 22px; color: var(--demo-text); align-items: center; justify-content: center; }
.demo-mode .pause:hover, .demo-mode .settings:hover { background-color: var(--demo-neutral-hover); scale: 1 1; }
.demo-mode .pause:focus, .demo-mode .settings:focus { border-color: var(--demo-focus); }
.demo-mode .pause:active, .demo-mode .settings:active { background-color: var(--demo-neutral-hover); scale: 1 1; }
.demo-mode .demo-hazard-hint { align-self: flex-start; max-width: 650px; margin: 8px 164px 0 12px; font-size: 15px; color: var(--demo-surface); -unity-text-align: middle-left; text-shadow: 0 1px 3px rgba(18, 38, 30, .85); }
.demo-mode .bottom-bar { align-self: center; align-items: stretch; width: 100%; min-width: 0; max-width: 980px; padding: 20px 24px; background-image: none; background-color: var(--demo-surface); border-radius: 24px; border-width: 1px; border-color: var(--demo-edge); color: var(--demo-text); }
.demo-mode.has-dialogue .bottom-bar { padding-right: 270px; }
.demo-mode.has-dialogue .demo-dialogue-dock { display: flex; margin-bottom: 16px; padding-bottom: 14px; border-bottom-width: 1px; border-bottom-color: var(--demo-edge); }
.demo-mode .demo-meta { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 14px; flex-shrink: 0; }
.demo-mode .demo-step-rule { margin: 0 12px 0 0; font-size: 14px; color: var(--demo-muted); -unity-text-align: middle-left; }
.demo-mode #actionsRemaining { margin: 0; font-size: 14px; color: var(--demo-speaker); -unity-font-style: bold; -unity-text-align: middle-left; }
.demo-mode .action-row { flex-direction: row; align-items: flex-start; justify-content: flex-start; flex-wrap: wrap; flex-shrink: 0; }
.demo-mode .demo-step-group { margin-right: 24px; flex-shrink: 0; }
.demo-mode .demo-hero-group { display: flex; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.demo-mode .demo-control-caption { display: flex; margin: 0 0 8px; padding: 0; color: var(--demo-speaker); font-size: 13px; -unity-font-style: bold; }
.demo-mode .moves { justify-content: flex-start; flex-wrap: nowrap; flex-shrink: 0; max-width: none; }
.demo-mode .move-token { width: 114px; height: 52px; min-height: 52px; margin: 0 8px 0 0; padding: 0 14px; background-image: none; background-color: var(--demo-neutral); border-width: 1px; border-color: var(--demo-edge); border-radius: 14px; color: var(--demo-text); font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center; }
.demo-mode .move-token.available { opacity: 1; color: var(--demo-text); }
.demo-mode .move-token.selected { background-color: var(--demo-accent); border-color: var(--demo-accent-edge); color: var(--demo-text); scale: 1 1; }
.demo-mode .move-token:hover { background-color: var(--demo-neutral-hover); }
.demo-mode .move-token.selected:hover { background-color: var(--demo-accent-hover); }
.demo-mode .move-token:focus { border-color: var(--demo-focus); }
.demo-mode .move-token:active { background-color: var(--demo-neutral-hover); }
.demo-mode .move-token.selected:active { background-color: var(--demo-accent); }
.demo-mode .move-token:disabled { opacity: .65; background-color: var(--demo-neutral); color: var(--demo-muted); }
.demo-mode .token-marker, .demo-mode .move-token.selected .token-marker { display: none; }
.demo-mode .demo-heroes { justify-content: flex-start; margin: 0; flex-grow: 1; flex-shrink: 1; max-width: 100%; }
.demo-mode .demo-hero { flex-shrink: 0; min-height: 52px; min-width: 104px; margin: 0 8px 8px 0; padding: 8px 20px; background-color: rgb(253, 250, 241); border-color: var(--demo-edge); border-width: 1px; border-radius: 14px; color: var(--demo-text); font-size: 19px; -unity-font-style: bold; }
.demo-mode .demo-hero.selected { background-color: rgb(223, 237, 224); border-color: var(--demo-speaker); border-width: 1px; }
.demo-mode .demo-hero:hover { background-color: var(--demo-neutral-hover); }
.demo-mode .demo-hero.selected:hover { background-color: rgb(210, 229, 213); }
.demo-mode .demo-hero:focus { border-color: var(--demo-focus); }
.demo-mode .demo-hero:active { background-color: rgb(210, 229, 213); }
.demo-mode .demo-hero:disabled { opacity: .65; }
.demo-mode .demo-hero.arrived { opacity: 1; color: rgb(76, 105, 83); background-color: rgb(228, 238, 224); border-color: rgb(208, 223, 203); }
.demo-mode #selectedHero { display: none; }
.demo-mode .bottom-line { display: flex; justify-content: flex-start; margin-top: 6px; }
.demo-mode.has-dialogue .bottom-line { display: none; }
.demo-mode.has-input-feedback .bottom-line { display: flex; }
.demo-mode #hint { color: var(--demo-muted); font-size: 15px; -unity-text-align: middle-left; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.demo-mode.has-input-feedback #hint { color: rgb(143, 75, 43); }
.demo-mode.narrative-modal .hud-header, .demo-mode.narrative-modal .bottom-bar { display: none; }
.demo-mode .pause-window { background-image: none; background-color: var(--demo-surface); color: var(--demo-text); border-width: 1px; border-color: var(--demo-edge); border-radius: 24px; padding: 24px; }
.demo-mode .pause-title { background-image: none; min-height: 52px; padding: 8px 0; color: var(--demo-text); text-shadow: 0 0 0 rgba(0, 0, 0, 0); font-size: 26px; }
.demo-mode .pause-window .pause-action { background-image: none; background-color: var(--demo-neutral); border-color: var(--demo-edge); border-width: 1px; border-radius: 14px; color: var(--demo-text); min-height: 48px; font-size: 18px; }
.demo-mode .pause-window .pause-action:hover { background-color: var(--demo-neutral-hover); }
.demo-mode .pause-window .pause-primary { background-color: var(--demo-accent); border-color: var(--demo-accent-edge); }
.demo-mode .pause-window .pause-primary:hover { background-color: var(--demo-accent-hover); }
.demo-mode .pause-window .pause-surrender { color: rgb(143, 75, 43); }
.demo-mode .pause-toggle { color: var(--demo-text); }
.demo-mode .pause-confirm-message { color: var(--demo-muted); }
.demo-mode.compact .demo-title { font-size: 19px; margin-right: 12px; }
.demo-mode.compact .score-panel { margin-right: 12px; padding-left: 12px; }
.demo-mode.compact .turn { font-size: 12px; }
.demo-mode.portrait .top-bar { flex-wrap: wrap; align-items: flex-start; padding: 10px 14px; }
.demo-mode.portrait .demo-title { max-width: 100%; width: 100%; margin: 0 0 6px; font-size: 18px; }
.demo-mode.portrait .score-panel { flex-grow: 0; padding-left: 0; border-left-width: 0; }
.demo-mode.portrait .turn-plaque { height: 32px; }
.demo-mode.portrait .demo-hazard-hint { margin-top: 8px; font-size: 14px; }
.demo-mode.portrait .bottom-bar { max-width: 100%; padding: 18px; border-radius: 22px; }
.demo-mode.portrait.has-dialogue .bottom-bar { padding-right: 18px; }
.demo-mode.portrait .demo-meta { margin-bottom: 12px; }
.demo-mode.portrait .demo-step-rule, .demo-mode.portrait #actionsRemaining { font-size: 13px; }
.demo-mode.portrait .demo-step-group { margin-right: 18px; }
.demo-mode.portrait .move-token { width: 100px; margin-right: 6px; font-size: 18px; }
.demo-mode.portrait .demo-hero { min-width: 86px; padding: 8px 14px; margin-right: 6px; font-size: 18px; }
.demo-mode.narrow .demo-step-group { margin-bottom: 12px; }
.demo-mode.narrow .demo-hero-group { flex-basis: 100%; }

.demo-mode .pause-window .pause-action:focus { border-width: 1px; border-color: var(--demo-focus); border-radius: 14px; }
.demo-mode .pause-window .pause-action:active { background-color: var(--demo-neutral-hover); }
.demo-mode .pause-window .pause-primary:active { background-color: var(--demo-accent); }
.demo-mode .pause-toggle-check { background-color: var(--demo-neutral); border-color: var(--demo-edge); border-radius: 8px; }
.demo-mode .pause-toggle:checked .pause-toggle-check { background-color: var(--demo-speaker); border-color: var(--demo-speaker); }
.demo-mode .pause-toggle:hover .pause-toggle-check { border-color: var(--demo-focus); }
