#JoTutorialPanel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; overflow: hidden; background-color: rgb(41, 39, 23); }
.jo-stage { position: absolute; width: 1672px; height: 941px; flex-shrink: 0; background-image: url('../../07_Art/UI/GlimblehopMenu/jo-tutorial-approved.png'); background-size: 100% 100%; }
.jo-title { position: absolute; left: 738px; top: 45px; width: 580px; height: 88px; font-size: 52px; color: rgb(255,229,181); -unity-font-definition: url('../../07_Art/Fonts/AlfaSlabOne-Regular.ttf'); -unity-text-align: middle-center; white-space: normal; text-shadow: 0 3px 1px rgb(64,34,15); }
.jo-counter { position: absolute; left: 1390px; top: 65px; width: 120px; font-size: 37px; color: rgb(77,46,24); -unity-text-align: middle-center; }
.jo-close { position: absolute; left: 1530px; top: 42px; width: 92px; height: 92px; background-image: none; background-color: rgb(124,82,41); border-radius: 50px; border-width: 3px; border-color: rgb(208,158,92); font-size: 70px; color: rgb(64,35,16); -unity-text-align: middle-center; }
.jo-close:hover { color: rgb(177,57,31); scale: 1.04; }
.jo-speech { position: absolute; left: 367px; top: 110px; width: 242px; height: 121px; font-size: 25px; color: rgb(65,39,21); white-space: normal; -unity-text-align: middle-center; }
.jo-hint { position: absolute; left: 720px; top: 700px; width: 760px; height: 48px; font-size: 28px; color: rgb(89,78,38); -unity-text-align: middle-center; white-space: normal; }
.jo-choices { position: absolute; left: 615px; top: 173px; width: 990px; height: 305px; flex-direction: row; justify-content: space-around; align-items: center; }
.jo-token { width: 298px; height: 298px; border-width: 0; background-color: transparent; border-radius: 160px; padding: 0; margin: 0; transition-property: scale; transition-duration: .15s; }
.jo-token:hover { scale: 1.035; }
.jo-token.jo-selected { background-color: transparent; scale: 1.05; }
.jo-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.jo-selected-reminder { position: absolute; left: 1010px; top: 180px; width: 230px; height: 230px; }
.jo-demo { position: absolute; left: 707px; top: 440px; width: 796px; height: 230px; }
.jo-second-page .jo-demo { top: 410px; height: 280px; }
.jo-path { position: absolute; left: 0; right: 0; bottom: 0; height: 158px; flex-direction: row; }
.jo-tile { width: 16.6667%; height: 158px; }
.jo-goblin { position: absolute; bottom: 55px; width: 16.6667%; height: 165px; margin: 0; padding: 0; background-color: transparent; border-width: 0; }
.jo-goblin:hover { scale: 1.06; }
.jo-goblin:disabled { opacity: 1; }
.jo-ghost { opacity: .3; }
.jo-back, .jo-next { position: absolute; top: 765px; width: 360px; height: 105px; font-size: 30px; -unity-font-definition: url('../../07_Art/Fonts/AlfaSlabOne-Regular.ttf'); }
.jo-back { left: 620px; }
.jo-next { left: 1195px; }

.jo-token.jo-selected .jo-art { border-width: 3px; border-color: rgb(255,226,141); border-radius: 160px; }
.jo-tile .jo-art { width: 132%; left: -16%; }

/* Shared typography on both slides: keep the text within the painted plaques. */
.jo-title { font-size: 46px; -unity-font-style: bold; }
.jo-speech { left: 370px; top: 107px; width: 236px; height: 112px; font-size: 24px; -unity-font-style: bold; }
.jo-hint, .jo-counter { -unity-font-style: bold; }
.jo-close { background-color: transparent; border-width: 0; padding: 0; }

.jo-close { background-image: url('../../07_Art/UI/GlimblehopMenu/tutorial-close.png'); background-size: contain; background-repeat: no-repeat; background-position: center; width: 112px; height: 112px; left: 1520px; top: 32px; }
.jo-close:hover { -unity-background-image-tint-color: rgb(255,206,160); }
