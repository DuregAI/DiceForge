<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/03_UI/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=433aa71b50974ae1a70e531afc4e3cb3&amp;type=3#MainMenu"/>
    <Style src="project://database/Assets/_Project/03_UI/Progression/Chests/ChestOpenView.uss?fileID=7433441132597879392&amp;guid=6dfe7a5b29234a0692fb749fd9c436ed&amp;type=3#ChestOpenView"/>
    <Style src="project://database/Assets/_Project/03_UI/_Theme/Colors.uss?fileID=7433441132597879392&amp;guid=adbf249822804c06897bf8be4219bd5e&amp;type=3#Colors"/>
    <Style src="project://database/Assets/_Project/03_UI/_Theme/Typography.uss?fileID=7433441132597879392&amp;guid=d79744cf0e424d25b9b480810a4e8f24&amp;type=3#Typography"/>
    <Style src="project://database/Assets/_Project/03_UI/_Theme/Spacing.uss?fileID=7433441132597879392&amp;guid=6f87a6afb6b647fb9ace9bdf3d801eb2&amp;type=3#Spacing"/>
    <Style src="project://database/Assets/_Project/03_UI/_Theme/Components.uss?fileID=7433441132597879392&amp;guid=b93333b4e289421c8f7e6d002f6b7d55&amp;type=3#Components"/>
    <Style src="project://database/Assets/_Project/03_UI/Player/PlayerPanel.uss?fileID=7433441132597879392&amp;guid=895f9e64e7fe479fb01aab1ab602fe35&amp;type=3#PlayerPanel"/>
    <Style src="GlimblehopMenu.uss"/>
    <Style src="JoTutorial.uss"/>
    <ui:VisualElement name="Root" class="gh-core-menu">
        <ui:VisualElement name="Center" enabled="true">
            <ui:VisualElement name="MenuPanel" enabled="true" class="panel is-visible">
                <ui:VisualElement name="GlimblehopLogo" picking-mode="Ignore"/>
                <ui:VisualElement name="ModeButtonsColumn">
                    <ui:Button name="btnLong" text="PLAY" class="gh-button gh-primary"/>
                    <ui:Button name="btnMyGoblins" text="MY GOBLINS" class="gh-button"/>
                    <ui:Button name="btnTutorial" text="HOW TO PLAY" class="gh-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="gh-dev">
                    <ui:Button name="btnShort" text="SHORT (DEV)" class="gh-utility"/>
                    <ui:Button name="btnExperimental" text="EXPERIMENTAL (DEV)" class="gh-utility"/>
                </ui:VisualElement>
                <ui:Label name="GlimblehopChapter" text="Chapter 1 · Woodland Trail"/>
                <ui:Button name="btnMenuProfile" class="gh-profile" tooltip="Open player profile">
                    <ui:VisualElement class="gh-avatar" picking-mode="Ignore"/>
                    <ui:Label name="menuLevel" text="Lv 1" picking-mode="Ignore"/>
                </ui:Button>
                <ui:Button name="btnInventory" class="gh-wallet" tooltip="Inventory, resources and upgrades">
                    <ui:VisualElement class="gh-coin" picking-mode="Ignore"/>
                    <ui:Label name="menuCoins" text="0" picking-mode="Ignore"/>
                    <ui:Label text="INVENTORY" class="gh-wallet-caption" picking-mode="Ignore"/>
                </ui:Button>
                <ui:Button name="btnMenuAudio" class="gh-audio" tooltip="Mute audio"/>
                <ui:Button name="btnLanguage" class="gh-language" tooltip="English · Русский · 简体中文"/>
                <ui:Button name="btnLegal" text="Legal" class="gh-legal-link" tooltip="Legal and build information"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="JoTutorialPanel">
            <ui:VisualElement name="JoStage" class="jo-stage">
                <ui:Button name="JoClose" tooltip="Close" class="jo-close"/>
                <ui:Label name="JoCounter" class="jo-counter"/>
                <ui:Label name="JoTitle" class="jo-title"/>
                <ui:Label name="JoSpeech" class="jo-speech"/>
                <ui:Label name="JoHint" class="jo-hint"/>
                <ui:VisualElement name="JoChoices" class="jo-choices">
                    <ui:Button name="JoStep1" class="jo-token"/>
                    <ui:Button name="JoStep3" class="jo-token"/>
                    <ui:Button name="JoStep5" class="jo-token"/>
                </ui:VisualElement>
                <ui:VisualElement name="JoSelected" class="jo-selected-reminder" picking-mode="Ignore"/>
                <ui:VisualElement name="JoDemo" class="jo-demo">
                    <ui:VisualElement name="JoPath" class="jo-path">
                        <ui:VisualElement class="jo-tile"/><ui:VisualElement class="jo-tile"/><ui:VisualElement class="jo-tile"/><ui:VisualElement class="jo-tile"/><ui:VisualElement class="jo-tile"/><ui:VisualElement class="jo-tile"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="JoGhost" class="jo-goblin jo-ghost" picking-mode="Ignore"/>
                    <ui:Button name="JoGoblin" class="jo-goblin"/>
                </ui:VisualElement>
                <ui:Button name="JoBack" text="BACK" class="gh-button jo-back"/>
                <ui:Button name="JoNext" class="gh-button gh-primary jo-next"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsPanel" class="settings-overlay gh-settings-overlay">
            <ui:VisualElement name="SettingsWindow" class="gh-settings-window">
                <ui:Button name="btnCloseSettings" text="×" tooltip="Close settings" class="gh-settings-close"/>
                <ui:Label text="SETTINGS" class="gh-settings-title"/>
                <ui:VisualElement name="SettingsSoundBlock" class="gh-sound-block">
                    <ui:Button name="btnSettingsMute" class="gh-speaker" tooltip="Mute audio"/>
                    <ui:VisualElement name="SettingsAudioControls" class="gh-audio-controls">
                        <ui:Label text="Music" class="gh-audio-label"/>
                        <ui:Slider name="sliderMusicVolume" low-value="0" high-value="1" value="0.7" class="gh-slider"/>
                        <ui:Label text="Sound effects" class="gh-audio-label"/>
                        <ui:Slider name="sliderSfxVolume" low-value="0" high-value="1" value="0.7" class="gh-slider"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="gh-settings-actions">
                    <ui:Button name="btnCopyLog" text="COPY LOG" class="gh-button"/>
                    <ui:Button name="btnOpenFeedback" text="FEEDBACK" class="gh-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="gh-settings-build">
                    <ui:Label name="lblAboutVersion" text="Version"/>
                    <ui:Label name="lblBuildInfo" text="Build: dev"/>
                </ui:VisualElement>
                <ui:Button name="btnSettingsDone" text="DONE" class="gh-button gh-primary gh-settings-done"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="LegalPanel" class="settings-overlay gh-legal-overlay">
            <ui:VisualElement class="gh-legal-window">
                <ui:Button name="btnCloseLegal" text="×" tooltip="Close legal information" class="gh-settings-close"/>
                <ui:Label text="LEGAL" class="gh-settings-title"/>
                <ui:ScrollView class="gh-legal-scroll" mode="Vertical">
                    <ui:Label text="TERMS OF USE" class="gh-section-heading"/>
                    <ui:Label text="You may install and play a lawfully obtained copy of Glimblehop for personal, non-commercial use, subject to applicable law and the distribution platform's terms. The game is licensed, not sold. Rights in the game and its content remain with their respective owners." class="gh-legal-body"/>
                    <ui:Label text="Do not disrupt online services, gain unauthorized access, distribute malicious software, or submit unlawful or abusive content. Do not redistribute game assets without permission, except where permitted by law or the applicable license." class="gh-legal-body"/>
                    <ui:Label text="This is a development build. Features and online availability may change, and progress may be lost or reset. To the extent permitted by law, the build is provided as available without a guarantee that it will be uninterrupted or error-free. Nothing in these terms excludes mandatory consumer rights or liability that cannot lawfully be excluded." class="gh-legal-body"/>
                    <ui:Label text="You may stop using the game at any time. Any mandatory purchase or refund rights and the relevant store's terms continue to apply. Material changes to these terms will be identified in an updated notice; any agreement required by law will be requested separately." class="gh-legal-body"/>
                    <ui:Label text="PRIVACY POLICY" class="gh-section-heading"/>
                    <ui:Label text="Local data. The game stores progress, player identifiers, preferences and audio settings on your device. Removing local application data can erase progress and settings. Resetting a campaign does not necessarily remove other stored data or records already sent to a server." class="gh-legal-body"/>
                    <ui:Label text="Online data. When connected, the game can send session identifiers, session times and duration, build version, platform, operating system, CPU and GPU names, screen dimensions, frame-rate and performance measurements, and battle counts. Online features can also send player-name changes and music events or votes." class="gh-legal-body"/>
                    <ui:Label text="Feedback. If you send feedback, the submission includes your message and category, feedback identifier and timestamp, player and session identifiers, player name, build version and scene. Please do not include passwords, payment details or sensitive personal information." class="gh-legal-body"/>
                    <ui:Label text="Purposes. Local storage supports gameplay and remembers your settings. Online records support connected features and help investigate performance and bugs. Feedback records help review and respond to reports. Opening this notice does not itself provide consent to data processing." class="gh-legal-body"/>
                    <ui:Label text="Your rights. Depending on your location and applicable law, you may request access, correction, deletion or a copy of your personal data, object to or restrict processing, and withdraw consent where processing relies on consent. You may also complain to your local data protection authority. Proportionate identity verification may be needed to process a request." class="gh-legal-body"/>
                    <ui:Label text="Children. Do not submit personal information about children through feedback." class="gh-legal-body"/>
                    <ui:Label text="Updates. This notice will be updated when data practices change. Material changes and any choices required by applicable law will be communicated before the relevant new processing begins." class="gh-legal-body"/>
                    <ui:Label text="THIRD-PARTY NOTICES" class="gh-section-heading"/>
                    <ui:Label text="Built with Unity. Online integration uses SpacetimeDB. Third-party software, fonts and assets remain subject to their respective licenses. Their names identify technology used by the game and do not imply endorsement." class="gh-legal-body"/>
                </ui:ScrollView>
                <ui:Button name="btnLegalDone" text="BACK" class="gh-button gh-primary gh-settings-done"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="UpgradeShopPanel" class="settings-overlay">
            <ui:VisualElement class="upgrade-shop-window">
                <ui:VisualElement class="upgrade-shop-content">
                    <ui:VisualElement class="upgrade-shop-header">
                        <ui:Label text="Upgrades" class="upgrade-shop-title df-label"/>
                        <ui:Label text="Invest coins into passive boosts and shape your next runs." class="upgrade-shop-subtitle df-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="upgrade-shop-toolbar">
                        <ui:VisualElement class="upgrade-shop-currency-pill">
                            <ui:VisualElement class="upgrade-shop-currency-icon"/>
                            <ui:Label name="upgradeShopCoins" text="0" class="upgrade-shop-coins df-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="upgradeList" class="upgrade-list"/>
                    <ui:VisualElement class="upgrade-shop-footer">
                        <ui:Label text="Upgrade choices unlock stronger runs over time." class="upgrade-shop-footer-copy df-label"/>
                        <ui:Button name="btnCloseUpgrades" text="Close" class="chest-shop-buy-button chest-shop-buy-button-secondary upgrade-shop-close df-interactive"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ChestShopPanel" class="settings-overlay">
            <ui:VisualElement name="chestShopWindow" class="chest-shop-window">
                <ui:VisualElement class="chest-shop-content">
                    <ui:VisualElement class="chest-shop-header">
                        <ui:Label text="Chest Shop" class="chest-shop-title df-label"/>
                        <ui:Label text="Choose a tier and stock your next run with treasure." class="chest-shop-subtitle df-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="chest-shop-list">
                        <ui:VisualElement class="chest-shop-card chest-shop-card-small">
                            <ui:VisualElement class="chest-shop-card-left">
                                <ui:VisualElement class="chest-shop-card-icon-wrap">
                                    <ui:VisualElement class="chest-shop-card-halo chest-shop-card-halo-small"/>
                                    <ui:VisualElement class="chest-shop-card-icon chest-shop-card-icon-small"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="chest-shop-card-copy">
                                    <ui:Label text="Small Chest" class="chest-shop-card-title df-label"/>
                                    <ui:Label text="Starter stash with steady gold and clean utility rewards." class="chest-shop-card-subtitle df-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="chest-shop-card-right">
                                <ui:VisualElement class="chest-shop-price">
                                    <ui:VisualElement class="chest-shop-price-icon chest-shop-price-icon-gold"/>
                                    <ui:Label name="lblSmallChestPrice" text="80 Gold" class="chest-shop-price-label df-label"/>
                                </ui:VisualElement>
                                <ui:Button name="btnBuySmallChest" text="Buy" class="chest-shop-buy-button chest-shop-buy-button-primary df-interactive"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="chest-shop-card chest-shop-card-medium">
                            <ui:VisualElement class="chest-shop-card-left">
                                <ui:VisualElement class="chest-shop-card-icon-wrap">
                                    <ui:VisualElement class="chest-shop-card-halo chest-shop-card-halo-medium"/>
                                    <ui:VisualElement class="chest-shop-card-icon chest-shop-card-icon-medium"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="chest-shop-card-copy">
                                    <ui:Label text="Medium Chest" class="chest-shop-card-title df-label"/>
                                    <ui:Label text="Bigger haul with a richer drop feel and stronger payout curve." class="chest-shop-card-subtitle df-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="chest-shop-card-right">
                                <ui:VisualElement class="chest-shop-price">
                                    <ui:VisualElement class="chest-shop-price-icon chest-shop-price-icon-gold"/>
                                    <ui:Label name="lblMediumChestPrice" text="180 Gold" class="chest-shop-price-label df-label"/>
                                </ui:VisualElement>
                                <ui:Button name="btnBuyMediumChest" text="Buy" class="chest-shop-buy-button chest-shop-buy-button-primary df-interactive"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="chest-shop-card chest-shop-card-essence">
                            <ui:VisualElement class="chest-shop-card-left">
                                <ui:VisualElement class="chest-shop-card-icon-wrap">
                                    <ui:VisualElement class="chest-shop-card-halo chest-shop-card-halo-essence"/>
                                    <ui:VisualElement class="chest-shop-card-icon chest-shop-card-icon-essence"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="chest-shop-card-copy">
                                    <ui:Label text="Essence Chest" class="chest-shop-card-title df-label"/>
                                    <ui:Label text="Arcane purchase paid in essence with brighter magical rewards." class="chest-shop-card-subtitle df-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="chest-shop-card-right">
                                <ui:VisualElement class="chest-shop-price">
                                    <ui:VisualElement class="chest-shop-price-icon chest-shop-price-icon-essence"/>
                                    <ui:Label name="lblEssenceChestPrice" text="12 Essence" class="chest-shop-price-label df-label"/>
                                </ui:VisualElement>
                                <ui:Button name="btnBuyEssenceChest" text="Buy" class="chest-shop-buy-button chest-shop-buy-button-primary df-interactive"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="chest-shop-footer">
                        <ui:Label name="chestShopStatus" text="" class="chest-shop-status df-label"/>
                        <ui:Button name="btnCloseChestShop" text="Close" class="chest-shop-buy-button chest-shop-buy-button-secondary chest-shop-close df-interactive"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="chestShopFx" class="chest-shop-fx">
                        <ui:VisualElement name="chestShopFxGlow" class="chest-shop-fx-glow"/>
                        <ui:VisualElement name="chestShopFxSweepPrimary" class="chest-shop-fx-sweep chest-shop-fx-sweep-primary"/>
                        <ui:VisualElement name="chestShopFxSweepAccent" class="chest-shop-fx-sweep chest-shop-fx-sweep-accent"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ChestOpenPanel" class="settings-overlay chest-open-overlay">
            <ui:VisualElement class="chest-open-window">
                <ui:VisualElement class="chest-open-shell">
                    <ui:VisualElement class="chest-open-header">
                        <ui:Label name="chestOpenTitle" text="Treasure Chests" class="chest-open-title df-label"/>
                        <ui:Label name="chestOpenSubtitle" text="Tap a chest to crack it open and collect the haul." class="chest-open-subtitle df-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="chest-open-main">
                        <ui:VisualElement class="chest-open-preview-panel">
                            <ui:VisualElement class="chest-open-preview-card">
                                <ui:VisualElement name="chestOpenFx" class="chest-open-fx"/>
                                <ui:Button name="btnOpenChestScreen" text="" class="chest-open-preview-button df-interactive">
                                    <ui:VisualElement name="chestPreviewHalo" class="chest-preview-halo chest-preview-halo--basic"/>
                                    <ui:VisualElement name="chestPreviewIcon" class="chest-preview-icon chest-preview-icon--basic"/>
                                    <ui:Label name="chestPreviewCount" text="x0" class="chest-preview-count df-label"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:Label name="chestInfoLabel" text="No chests waiting" class="chest-info-label df-label"/>
                            <ui:Label name="chestInfoHint" text="Collect chests from battles and the shop to stock this stash." class="chest-info-hint df-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="chest-open-side">
                            <ui:VisualElement class="chest-open-inventory-panel">
                                <ui:VisualElement class="chest-open-section-header">
                                    <ui:Label text="Your Stash" class="chest-open-section-title df-label"/>
                                    <ui:Label name="chestQueueSummary" text="0 ready" class="chest-open-section-count df-label"/>
                                </ui:VisualElement>
                                <ui:ScrollView name="chestInventoryList" mode="Vertical" class="chest-inventory-list"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="chestRewardsContainer" class="chest-rewards-container reward-hidden">
                                <ui:VisualElement class="chest-open-section-header">
                                    <ui:Label text="Rewards" class="chest-reward-title df-label"/>
                                    <ui:Label name="chestRewardBurstLabel" text="" class="chest-reward-burst df-label"/>
                                </ui:VisualElement>
                                <ui:ScrollView name="chestRewardsList" class="chest-rewards-list"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="chest-actions-row">
                        <ui:Label name="chestOpenTip" text="Tap any chest card to open one instantly." class="chest-open-tip df-label"/>
                        <ui:Button name="btnCloseChestScreen" text="Close" class="chest-shop-buy-button chest-shop-buy-button-secondary chest-open-close df-interactive"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="LeftSidebar" class="left-sidebar">
            <ui:Button name="btnCloseInventory" text="CLOSE INVENTORY" class="gh-utility"/>
            <ui:Button name="btnUpgrades" text="UPGRADES" class="gh-utility"/>
            <ui:VisualElement class="left-sidebar-frame">
                <ui:VisualElement class="left-sidebar-content">
                    <ui:VisualElement name="PlayerPanel" class="player-panel">
                        <ui:VisualElement class="player-panel-top-row">
                            <ui:VisualElement class="player-avatar-stack">
                                <ui:VisualElement class="player-avatar-frame">
                                    <ui:Button name="btnPlayerAvatar" text="" class="player-avatar-button df-interactive"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="player-level-badge">
                                    <ui:Label name="playerPanelLevel" text="Lv 1" class="player-panel-level df-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="btnPlayerRename" text="" class="player-name-plaque df-interactive">
                            <ui:Label name="playerPanelName" text="Player" class="player-panel-name df-label"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="WalletPanel" class="wallet-panel">
                        <ui:VisualElement class="wallet-section wallet-section-resources">
                            <ui:VisualElement class="wallet-row">
                                <ui:VisualElement class="wallet-row-leading">
                                    <ui:VisualElement class="wallet-row-icon wallet-row-icon-coins"/>
                                    <ui:Label text="Coins" class="wallet-row-title"/>
                                </ui:VisualElement>
                                <ui:Label name="walletCoins" text="0" class="wallet-row-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="wallet-row">
                                <ui:VisualElement class="wallet-row-leading">
                                    <ui:VisualElement class="wallet-row-icon wallet-row-icon-essence"/>
                                    <ui:Label text="Essence" class="wallet-row-title"/>
                                </ui:VisualElement>
                                <ui:Label name="walletEssence" text="0" class="wallet-row-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="wallet-row">
                                <ui:VisualElement class="wallet-row-leading">
                                    <ui:VisualElement class="wallet-row-icon wallet-row-icon-shards"/>
                                    <ui:Label text="Shards" class="wallet-row-title"/>
                                </ui:VisualElement>
                                <ui:Label name="walletShards" text="0" class="wallet-row-value"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="wallet-section wallet-section-xp">
                            <ui:VisualElement class="wallet-row wallet-row-tight">
                                <ui:VisualElement class="wallet-row-leading">
                                    <ui:VisualElement class="wallet-row-icon wallet-row-icon-xp"/>
                                    <ui:Label text="Hero XP" class="wallet-row-title"/>
                                </ui:VisualElement>
                                <ui:Label name="walletXpProgress" text="0/100" class="wallet-row-progress"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="wallet-xp-bar">
                                <ui:VisualElement class="wallet-xp-bar-track">
                                    <ui:VisualElement name="walletXpFill" class="wallet-xp-fill"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="walletChestSection" class="wallet-section wallet-section-chest">
                            <ui:VisualElement class="wallet-feature-card wallet-feature-card-chest">
                                <ui:Button name="btnWalletOpenChest" text="" class="wallet-chest-button df-interactive">
                                    <ui:VisualElement class="wallet-chest-art"/>
                                    <ui:Label name="walletChests" text="+" class="wallet-chest-badge df-label"/>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="walletDevActions" class="wallet-actions">
                            <ui:Label text="Dev Actions" class="wallet-actions-title df-label"/>
                            <ui:Button name="btnWalletAddXp" text="+50 XP" class="left-sidebar-button left-sidebar-button-secondary left-sidebar-button-utility df-interactive"/>
                            <ui:Button name="btnWalletDebugLevelUp" text="Test Level Up" class="left-sidebar-button left-sidebar-button-secondary left-sidebar-button-utility df-interactive" style="margin-top: 8px;"/>
                            <ui:Button name="btnWalletDebugLevelUnlock" text="Test 1 Unlock" class="left-sidebar-button left-sidebar-button-secondary left-sidebar-button-utility df-interactive" style="margin-top: 8px;"/>
                            <ui:Button name="btnWalletDebugLevelMulti" text="Test Multi Unlock" class="left-sidebar-button left-sidebar-button-secondary left-sidebar-button-utility df-interactive" style="margin-top: 8px;"/>
                            <ui:Button name="btnWalletDebugChestReward" text="Test Chest Reward" class="left-sidebar-button left-sidebar-button-secondary left-sidebar-button-utility df-interactive" style="margin-top: 8px;"/>
                            <ui:Button name="btnWalletAddCoins" text="+100 coins" class="left-sidebar-button left-sidebar-button-secondary left-sidebar-button-utility df-interactive" style="margin-top: 8px;"/>
                            <ui:Button name="btnWalletReset" text="Reset Profile" class="left-sidebar-button left-sidebar-button-reset left-sidebar-button-utility df-interactive"/>
                        </ui:VisualElement>
                        <ui:Label name="walletChestResult" text="" class="wallet-result"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FeedbackModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window player-modal-dialog df-surface feedback-modal-window">
                <ui:Label text="Send Feedback" class="panel-title df-label"/>
                <ui:Label text="Category" class="df-label feedback-field-label"/>
                <ui:DropdownField name="feedbackCategoryField" class="df-input feedback-dropdown"/>
                <ui:Label text="Message" class="df-label feedback-field-label"/>
                <ui:TextField name="feedbackMessageField" multiline="true" class="df-input feedback-message-field"/>
                <ui:Label name="feedbackStatusLabel" text="" class="df-label feedback-status-label"/>
                <ui:VisualElement class="player-modal-actions feedback-modal-actions">
                    <ui:Button name="btnFeedbackSubmit" text="Submit" class="gh-button gh-primary"/>
                    <ui:Button name="btnFeedbackCancel" text="Cancel" class="gh-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PlayerInfoModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window player-profile-window df-surface">
                <ui:Button name="btnPlayerInfoAvatar" text="" class="player-avatar-button player-avatar-large player-info-avatar-button df-interactive"/>
                <ui:Label name="playerInfoName" text="Player" class="player-info-name df-label"/>
                <ui:Label name="playerInfoLevel" text="Lv 1" class="player-info-level df-label"/>
                <ui:Label name="playerInfoXp" text="XP 0" class="player-info-xp player-info-xp-centered df-label"/>
                <ui:VisualElement class="player-modal-actions player-profile-actions">
                    <ui:Button name="btnPlayerInfoRename" text="Rename" class="df-button df-interactive"/>
                    <ui:Button name="btnClosePlayerInfo" text="Close" class="df-button df-interactive"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="AvatarSelectionModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window avatar-selection-window df-surface">
                <ui:Label text="Avatar Selection" class="avatar-selection-title df-label"/>
                <ui:Label name="avatarSelectionStatus" text="Selected: Avatar" class="avatar-selection-status df-label"/>
                <ui:ScrollView name="avatarSelectionScroll" mode="Vertical" class="avatar-selection-scroll">
                    <ui:VisualElement name="avatarSelectionGrid" class="avatar-selection-grid"/>
                </ui:ScrollView>
                <ui:VisualElement class="player-modal-actions avatar-selection-actions">
                    <ui:Button name="btnAvatarShop" text="Avatar Shop" class="df-button df-interactive"/>
                    <ui:Button name="btnCloseAvatarSelection" text="Close" class="df-button df-interactive"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="AvatarShopPlaceholderModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window player-modal-dialog df-surface avatar-shop-placeholder-window">
                <ui:Label text="Avatar Shop" class="panel-title df-label"/>
                <ui:Label name="avatarShopPlaceholderText" text="More avatars are coming soon. This entry point is ready for future cosmetic unlocks." class="player-confirm-text df-label avatar-shop-placeholder-text"/>
                <ui:VisualElement class="player-modal-actions">
                    <ui:Button name="btnCloseAvatarShopPlaceholder" text="Close" class="df-button df-interactive"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialReplayConfirmModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window player-modal-dialog df-surface">
                <ui:Label name="TutorialReplayConfirmText" text="Tutorial already completed. Replay?" class="player-confirm-text df-label"/>
                <ui:VisualElement class="player-modal-actions">
                    <ui:Button name="btnTutorialReplayYes" text="Yes" class="df-button df-interactive"/>
                    <ui:Button name="btnTutorialReplayCancel" text="Cancel" class="df-button df-interactive"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="RenameConfirmModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window player-modal-dialog df-surface">
                <ui:Label text="Do you want to change your name?" class="player-confirm-text df-label"/>
                <ui:VisualElement class="player-modal-actions">
                    <ui:Button name="btnRenameConfirmYes" text="Yes" class="df-button df-interactive"/>
                    <ui:Button name="btnRenameConfirmCancel" text="Cancel" class="df-button df-interactive"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="RenamePlayerModal" class="player-modal-overlay">
            <ui:VisualElement class="player-modal-window player-modal-dialog df-surface rename-player-window">
                <ui:Label text="Enter your new name" class="df-label rename-player-title"/>
                <ui:TextField name="txtRenamePlayer" class="df-input rename-player-input"/>
                <ui:VisualElement class="player-modal-actions rename-player-actions">
                    <ui:Button name="btnRenameApply" text="Apply" class="df-button df-interactive rename-player-button"/>
                    <ui:Button name="btnRenameCancel" text="Cancel" class="df-button df-interactive rename-player-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Corners" picking-mode="Ignore">
            <ui:VisualElement name="CornerBR" picking-mode="Ignore">
                <ui:Button name="btnSettings" tooltip="Settings" class="icon-button state-settings df-interactive"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
