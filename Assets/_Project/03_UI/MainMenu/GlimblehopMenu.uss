/* Landscape menu, authored at 1920 x 1080. Text and controls remain live. */
#Root {
    background-image: url("../../07_Art/UI/GlimblehopMenu/background-landscape-clean.png");
    background-size: cover;
    background-position: center;
}
#Center { left: 0; top: 0; right: 0; bottom: 0; translate: 0 0; }
#MenuPanel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#SettingsPanel { display: none; }
#GlimblehopLogo {
    position: absolute; left: 3%; top: 9%; width: 39%; height: 25%;
    background-image: url("../../07_Art/UI/GlimblehopMenu/logo.png");
    background-size: contain; background-repeat: no-repeat; background-position: center;
}
#GlimblehopTagline {
    position: absolute; left: 3%; top: 33%; width: 38%;
    font-size: 32px; color: rgb(250, 235, 206); -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgb(35, 26, 17);
}
#ModeButtonsColumn { position: absolute; left: 4%; top: 41%; width: 29%; align-items: center; }
/* Entrance owns translation temporarily; keep hover feedback responsive. */
#MenuPanel .menu-entering { transition-property: scale, -unity-background-image-tint-color; }
.gh-button {
    width: 83%; height: 100px; min-height: 100px; margin: 8px 0;
    background-image: url("../../07_Art/UI/GlimblehopMenu/button-secondary.png");
    background-color: transparent; background-size: 100% 100%; border-width: 0;
    color: rgb(56, 36, 21); font-size: 29px; -unity-font-style: bold;
    -unity-text-align: middle-center; transition-property: scale; transition-duration: 0.12s;
    /* 378 x 157 texture: preserve the rounded wooden ends and bevels. */
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.64;
}
.gh-button:hover { scale: 1.025 1.025; }
.gh-button:active { scale: 0.97 0.97; }
.gh-primary {
    width: 100%; height: 138px; min-height: 138px; font-size: 56px;
    background-image: url("../../07_Art/UI/GlimblehopMenu/button-primary.png");
    color: rgb(255, 241, 213); text-shadow: 0 2px 2px rgb(53, 39, 20);
    /* 447 x 159 texture: keep the entire leaf clusters in the end caps. */
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-top: 76;
    -unity-slice-bottom: 76;
    -unity-slice-scale: 0.87;
}
#GlimblehopChapter {
    position: absolute; left: 6%; top: 80%; color: rgb(250, 235, 206);
    font-size: 24px; text-shadow: 0 2px 3px rgb(35, 26, 17);
}
/* Scope the larger lettering to the two main actions, not modal buttons. */
#btnLong {
    -unity-font-definition: initial;
    -unity-font: url("../../07_Art/Fonts/AlfaSlabOne-Regular.ttf");
    -unity-font-style: normal;
    font-size: 56px;
    letter-spacing: 2px;
    padding-left: 72px; padding-right: 72px;
    color: rgb(255, 239, 200);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(64, 46, 24);
    text-shadow: 0 4px 0 rgb(40, 33, 17);
}
#btnTutorial {
    -unity-font-definition: initial;
    -unity-font: url("../../07_Art/Fonts/AlfaSlabOne-Regular.ttf");
    -unity-font-style: normal;
    font-size: 29px;
    letter-spacing: 0.5px;
    padding-left: 55px; padding-right: 55px;
    color: rgb(70, 42, 21);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgb(52, 32, 17);
    text-shadow: 0 2px 0 rgb(255, 235, 188);
}
.gh-action-icon {
    position: absolute; right: 75px; top: 50%;
    width: 44px; height: 48px; translate: 0 -50%;
}
#btnTutorial .gh-action-icon { right: 35px; width: 37px; height: 42px; }
.gh-language {
    position: absolute; right: 8.5%; bottom: 2%; width: 104px; height: 84px;
    margin: 0; padding: 0; border-width: 0; background-color: transparent;
    transition-property: scale; transition-duration: 0.14s;
}
.gh-language:hover { scale: 1.05 1.05; }
.gh-language:active { scale: 0.97 0.97; }
.locale-ru #btnLong { font-size: 52px; -unity-font-style: bold; letter-spacing: 0; }
.locale-ru #btnTutorial { font-size: 27px; -unity-font-style: bold; letter-spacing: 0; }
.locale-zh #btnLong { font-size: 47px; -unity-font-style: bold; letter-spacing: 1px; }
.locale-zh #btnTutorial { font-size: 31px; letter-spacing: 1px; }
.locale-ru .gh-settings-actions .gh-button { font-size: 19px; }
.locale-ru .gh-settings-hint { font-size: 16px; }
.gh-profile, .gh-wallet {
    position: absolute; top: 2%; flex-direction: row; align-items: center;
    background-color: rgba(40, 30, 19, 0.85); border-width: 0; border-radius: 60px;
    color: rgb(250, 235, 206); font-size: 32px; padding: 6px 24px 6px 6px;
}
.gh-profile { left: 2%; }
.gh-avatar { width: 102px; height: 102px; background-image: url("../../07_Art/UI/GlimblehopMenu/avatar.png"); background-size: contain; }
.gh-wallet { right: 7%; }
.gh-coin { width: 50px; height: 50px; background-image: url("../../07_Art/UI/GlimblehopMenu/coin.png"); background-size: contain; }
.gh-wallet-caption { font-size: 19px; margin-left: 16px; }
#Corners { position: absolute; left: auto; right: 2%; top: 2%; bottom: auto; width: 84px; height: 84px; }
#CornerBR { left: 0; right: 0; top: 0; bottom: 0; }
#btnSettings, .gh-audio {
    width: 84px; height: 84px; padding: 0; margin: 0; border-width: 0;
    background-color: transparent; background-size: contain;
    background-image: url("../../07_Art/UI/GlimblehopMenu/settings.png");
}
#btnSettings.state-back { background-image: url("../../07_Art/UI/GlimblehopMenu/settings.png"); }
.gh-audio { position: absolute; right: 2%; bottom: 2%; background-image: url("../../07_Art/UI/GlimblehopMenu/audio-on.png"); }
.gh-audio.is-muted { background-image: url("../../07_Art/UI/GlimblehopMenu/audio-off.png"); }
#LeftSidebar { display: none; left: 24px; top: 24px; bottom: 24px; width: 400px; background-color: rgb(44, 37, 25); }
#LeftSidebar.inventory-open { display: flex; }
.gh-utility { font-size: 22px; min-height: 42px; color: rgb(255, 238, 206); background-color: rgb(65, 77, 43); border-width: 0; margin: 4px; }

.gh-dev { position: absolute; left: 4%; bottom: 3%; flex-direction: row; }
.gh-dev .gh-utility { font-size: 18px; }

.gh-button, #btnSettings, .gh-audio {
    -unity-background-image-tint-color: rgb(240, 240, 240);
    transition-property: scale, translate, -unity-background-image-tint-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}
.gh-button:hover, #btnSettings:hover, .gh-audio:hover {
    scale: 1.035 1.035;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.gh-button:active, #btnSettings:active, .gh-audio:active {
    scale: 0.97 0.97;
    translate: 0 2px;
    -unity-background-image-tint-color: rgb(232, 232, 232);
}

/* Temporary gameplay iteration: remove gh-core-menu from Root to restore these entries. */
.gh-core-menu #btnMyGoblins,
.gh-core-menu #GlimblehopChapter,
.gh-core-menu #btnMenuProfile,
.gh-core-menu #btnInventory,
.gh-core-menu .gh-dev {
    display: none;
}

/* Settings stays above the menu and uses the same warm wood / moss palette. */
#SettingsPanel {
    background-color: rgba(24, 30, 18, 0.60);
    translate: 0 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}
#SettingsWindow {
    width: 760px; height: 950px; max-width: 94%; max-height: 96%;
    padding: 126px 90px 68px 90px;
    background-image: url("../../07_Art/UI/GlimblehopMenu/settings-panel.png");
    background-size: 100% 100%;
    color: rgb(65, 43, 25);
    translate: 0 20px; scale: 0.96 0.96;
    transition-property: translate, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
#SettingsPanel.is-visible #SettingsWindow { translate: 0 0; scale: 1 1; }
.gh-settings-title {
    font-size: 54px; -unity-font-style: bold; -unity-text-align: middle-center;
    -unity-font-definition: url("../../07_Art/Fonts/LuckiestGuy-Regular.ttf");
}
.gh-settings-subtitle { font-size: 23px; -unity-text-align: middle-center; color: rgb(113, 87, 53); margin-bottom: 26px; }
.gh-settings-close {
    position: absolute; right: 44px; top: 62px; width: 76px; height: 76px;
    background-color: rgb(91, 62, 34); border-radius: 28px; border-width: 2px;
    border-color: rgb(186, 142, 79); color: rgb(255, 237, 200); font-size: 37px;
    -unity-text-align: middle-center; padding: 0;
}
.gh-sound-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.gh-section-heading { font-size: 23px; -unity-font-style: bold; color: rgb(87, 101, 48); }
.gh-mute-switch {
    width: 160px; height: 45px; background-color: rgb(88, 111, 48);
    color: rgb(255, 244, 213); border-radius: 16px; border-width: 0;
    font-size: 19px; -unity-font-style: bold;
}
.gh-mute-switch.is-muted { background-color: rgb(120, 93, 64); }
.gh-volume-heading { flex-direction: row; justify-content: space-between; font-size: 27px; margin-top: 8px; }
#settingsMusicValue, #settingsSfxValue { color: rgb(95, 113, 50); -unity-font-style: bold; }
.gh-slider { height: 52px; margin: 4px 0 12px 0; }
.gh-slider .unity-base-slider__tracker {
    height: 12px; border-radius: 6px; background-color: rgb(115, 126, 64);
    border-width: 2px; border-color: rgb(81, 85, 41);
}
.gh-slider .unity-base-slider__dragger {
    width: 34px; height: 34px; border-radius: 17px;
    background-color: rgb(253, 228, 170); border-width: 4px; border-color: rgb(127, 88, 42);
}
.gh-slider .unity-base-slider__dragger-border { border-width: 0; }
.gh-slider:hover .unity-base-slider__dragger { background-color: rgb(255, 243, 210); }
.gh-settings-hint { font-size: 18px; color: rgb(114, 88, 55); -unity-text-align: middle-center; height: 26px; }
.gh-settings-divider { height: 2px; background-color: rgba(130, 99, 58, 0.25); margin: 16px 0 12px 0; }
.gh-settings-actions { flex-direction: row; justify-content: space-between; }
.gh-settings-actions .gh-button { width: 49%; height: 76px; min-height: 76px; font-size: 23px; margin: 0; -unity-slice-scale: 0.48; }
#copyLogTooltip { position: absolute; bottom: 230px; left: 90px; right: 90px; }
.gh-settings-build { flex-direction: row; justify-content: center; margin: 22px 0 12px 0; }
.gh-settings-build Label { font-size: 17px; color: rgb(122, 97, 65); margin: 0 8px; }
.gh-settings-done { width: 72%; height: 96px; min-height: 96px; align-self: center; font-size: 35px; margin: 0; -unity-slice-scale: 0.60; }
.gh-settings-close, .gh-mute-switch { transition-property: scale; transition-duration: 0.12s; }
.gh-settings-close:hover, .gh-mute-switch:hover { scale: 1.035 1.035; }
.gh-settings-close:active, .gh-mute-switch:active { scale: 0.97 0.97; }

.gh-legal-link {
    position: absolute; left: 3%; bottom: 4%; padding: 8px 12px;
    background-color: transparent; border-width: 0; font-size: 22px;
    color: rgb(240, 225, 192); text-shadow: 0 2px 3px rgb(35, 26, 17);
    border-bottom-width: 1px; border-bottom-color: rgba(240, 225, 192, 0.5);
}
.gh-legal-link:hover { color: white; border-bottom-color: white; }
#LegalPanel { display: none; background-color: rgba(24, 30, 18, 0.60); }
.gh-legal-window {
    width: 820px; height: 950px; max-width: 94%; max-height: 96%;
    padding: 126px 92px 102px 92px;
    background-image: url("../../07_Art/UI/GlimblehopMenu/settings-panel.png");
    background-size: 100% 100%; color: rgb(65, 43, 25);
}
.gh-legal-scroll {
    flex-grow: 1; flex-shrink: 1; min-height: 0; margin: 8px 0 18px 0;
    padding: 18px 12px 18px 20px;
    background-color: rgba(255, 237, 201, 0.48);
    border-radius: 28px; border-width: 0;
}
.gh-legal-scroll .unity-scroller--vertical { width: 24px; margin-left: 12px; }
.gh-legal-scroll .unity-scroller__low-button,
.gh-legal-scroll .unity-scroller__high-button { display: none; }
.gh-legal-scroll .unity-base-slider__tracker {
    left: 5px; margin-left: 0;
    width: 10px; background-color: rgb(179, 148, 96); border-radius: 5px;
    border-width: 1px; border-color: rgb(143, 109, 65);
}
.gh-legal-scroll .unity-base-slider__dragger {
    left: 0; margin-left: 0;
    width: 20px; min-height: 48px; border-radius: 10px;
    background-color: rgb(106, 119, 52); border-width: 2px; border-color: rgb(75, 83, 35);
}
.gh-legal-scroll .unity-base-slider__dragger:hover { background-color: rgb(132, 148, 67); }
.gh-legal-scroll .unity-base-slider__dragger-border { border-width: 0; }
#btnLegalDone { flex-shrink: 0; }
.gh-legal-body { white-space: normal; font-size: 24px; margin: 8px 10px 24px 0; }
.gh-legal-note { font-size: 20px; color: rgb(113, 87, 53); }
.locale-ru #LegalPanel .gh-settings-title { font-size: 32px; white-space: normal; }
#LegalPanel .gh-section-heading { white-space: normal; }

/* Chunky sound controls, shared by all three menu languages. */
#SettingsWindow {
    padding-bottom: 100px;
    -unity-font-definition: url("../../07_Art/Fonts/AlfaSlabOne-Regular.ttf");
}
.locale-ru #SettingsWindow { -unity-font-definition: url("Resources/Localization/RobotoSlab.ttf"); }
.locale-zh #SettingsWindow { -unity-font-definition: url("Resources/Localization/NotoSansCJKsc-Regular.otf"); }
.gh-sound-block { flex-direction: row; align-items: center; flex-grow: 1; min-height: 280px; margin: 20px 0 24px 0; }
.gh-audio-controls { flex-grow: 1; flex-shrink: 1; min-width: 0; transition-property: opacity; transition-duration: 0.15s; }
.gh-audio-controls.is-muted { opacity: 0.42; }
.gh-audio-label { font-size: 27px; margin: 6px 0 0 8px; color: rgb(74, 47, 24); }
.gh-speaker {
    width: 112px; height: 112px; min-width: 112px; margin: 0 24px 0 0; padding: 0;
    background-image: url("../../07_Art/UI/GlimblehopMenu/audio-on.png");
    background-size: contain; background-color: transparent; border-width: 0;
    transition-property: scale; transition-duration: 0.12s;
}
.gh-speaker.is-muted { background-image: url("../../07_Art/UI/GlimblehopMenu/audio-off.png"); }
.gh-speaker:hover { scale: 1.06 1.06; }
.gh-speaker:active { scale: 0.96 0.96; }
#SettingsWindow .gh-slider { height: 78px; margin: 0 6px 18px 6px; }
#SettingsWindow .gh-slider .unity-base-slider__tracker {
    height: 22px; border-radius: 8px; overflow: hidden;
    background-color: rgb(188, 153, 99); border-width: 3px; border-color: rgb(119, 81, 39);
}
.gh-volume-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(119, 146, 55); border-radius: 5px; border-top-width: 3px; border-top-color: rgb(173, 189, 91); }
#SettingsWindow .gh-slider .unity-base-slider__dragger {
    width: 48px; height: 48px; border-radius: 19px;
    background-color: rgb(255, 226, 160); border-width: 5px;
    border-left-color: rgb(166, 115, 53); border-top-color: rgb(218, 174, 91);
    border-right-color: rgb(115, 77, 36); border-bottom-color: rgb(115, 77, 36);
}
#SettingsWindow .gh-slider:hover .unity-base-slider__dragger { background-color: rgb(255, 240, 193); }
#SettingsWindow .gh-settings-build { margin: 22px 0; }
#SettingsWindow .gh-settings-build Label { font-size: 22px; }
#SettingsWindow .gh-settings-actions .gh-button { font-size: 21px; }
.locale-ru #SettingsWindow .gh-settings-actions .gh-button { font-size: 19px; }

/* Final alignment and a quieter speaker against the pale wood. */
.gh-speaker { translate: 0 10px; opacity: 0.86; scale: 0.94 0.94; }
.gh-speaker:hover { opacity: 1; scale: 1 1; }
#SettingsWindow .gh-slider .unity-base-slider__dragger { translate: 0 -2px; }

#FeedbackModal { background-color: rgba(24, 30, 18, 0.65); }
#FeedbackModal .feedback-modal-window {
    width: 800px; height: 880px; max-width: 94%; max-height: 96%;
    padding: 116px 86px 92px 86px; border-width: 0; border-radius: 0;
    background-color: transparent;
    background-image: url("../../07_Art/UI/GlimblehopMenu/settings-panel.png");
    background-size: 100% 100%;
    color: rgb(65, 43, 25);
    -unity-font-definition: url("../../07_Art/Fonts/AlfaSlabOne-Regular.ttf");
}
.locale-ru #FeedbackModal .feedback-modal-window { -unity-font-definition: url("Resources/Localization/RobotoSlab.ttf"); }
.locale-zh #FeedbackModal .feedback-modal-window { -unity-font-definition: url("Resources/Localization/NotoSansCJKsc-Regular.otf"); }
#FeedbackModal .panel-title { font-size: 36px; color: rgb(65, 43, 25); -unity-text-align: middle-center; margin: 0 0 22px 0; }
#FeedbackModal .feedback-field-label { font-size: 24px; color: rgb(83, 94, 43); margin: 12px 0 8px 0; }
#FeedbackModal .feedback-dropdown { height: 58px; min-height: 58px; padding: 0; margin: 0; border-width: 0; background-color: transparent; }
#FeedbackModal .feedback-dropdown .unity-base-field__input {
    background-color: rgb(245, 221, 173); border-width: 2px; border-color: rgb(157, 117, 61);
    border-radius: 12px; padding: 8px 14px; color: rgb(64, 43, 25); font-size: 24px;
}
#FeedbackModal .feedback-dropdown .unity-popup-field__text { background-color: transparent; color: rgb(64, 43, 25); font-size: 24px; }
#FeedbackModal .feedback-message-field { flex-grow: 1; flex-shrink: 1; min-height: 140px; height: auto; margin: 0; padding: 0; border-width: 0; background-color: transparent; }
#FeedbackModal .feedback-message-field .unity-base-text-field__input {
    background-color: rgba(255, 239, 205, 0.9); border-width: 2px; border-color: rgb(157, 117, 61);
    border-radius: 12px; padding: 14px; font-size: 24px; color: rgb(59, 40, 24);
    -unity-font-definition: initial; white-space: normal;
}
#FeedbackModal .feedback-status-label { font-size: 20px; min-height: 36px; margin: 12px 0; white-space: normal; }
#FeedbackModal .feedback-modal-actions { flex-direction: row; justify-content: space-between; margin: 8px 0 0 0; flex-shrink: 0; }
#FeedbackModal .feedback-modal-actions .gh-button { width: 48%; height: 84px; min-height: 84px; margin: 0; font-size: 28px; -unity-slice-scale: 0.53; }
#FeedbackModal .feedback-modal-actions .gh-primary { -unity-slice-scale: 0.53; }
#FeedbackModal .df-label { -unity-text-outline-width: 0; text-shadow: 0 0 0 transparent; }
#FeedbackModal .feedback-field-label { -unity-text-align: middle-left; }
