/* Shared close treatment, attached by ModalDismiss to every bound modal. */
.df-modal-close {
    background-image: url("../../../07_Art/UI/GlimblehopMenu/button-secondary.png");
    background-color: transparent;
    -unity-slice-left: 48; -unity-slice-right: 48;
    -unity-slice-top: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.5;
    border-width: 0; min-height: 64px; padding: 8px 24px;
    color: rgb(66, 40, 20); -unity-font-style: bold;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}
.df-modal-close:hover { scale: 1.06 1.06; -unity-background-image-tint-color: rgb(255, 246, 216); }
.df-modal-close:active { scale: 0.95 0.95; }
.df-modal-close.df-modal-close-icon {
    width: 96px; height: 96px; min-width: 96px; min-height: 96px;
    padding: 0; margin: 0; border-radius: 0;
    border-width: 0; background-color: transparent;
    -unity-slice-left: 0; -unity-slice-right: 0;
    -unity-slice-top: 0; -unity-slice-bottom: 0;
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/close-button-states.png?fileID=-1020008357&guid=3a62b22a14bb044479f548df7f99d40b&type=3#close_hover");
    background-size: contain; background-repeat: no-repeat; background-position: center;
    color: transparent; -unity-text-align: middle-center;
    transition-property: scale; transition-duration: 0.12s;
}
.df-window-close-icon { position: absolute; right: 14px; top: 14px; }
.df-modal-close.df-modal-close-icon:hover,
.df-modal-close.df-modal-close-icon:focus {
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/close-button-states.png?fileID=2110562698&guid=3a62b22a14bb044479f548df7f99d40b&type=3#close_normal");
}
.df-modal-close.df-modal-close-icon:active {
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/close-button-states.png?fileID=-715846277&guid=3a62b22a14bb044479f548df7f99d40b&type=3#close_pressed");
}
.df-modal-close.df-modal-close-icon:disabled {
    background-image: url("project://database/Assets/_Project/07_Art/UI/GlimblehopMenu/close-button-states.png?fileID=1134719527&guid=3a62b22a14bb044479f548df7f99d40b&type=3#close_disabled");
}
